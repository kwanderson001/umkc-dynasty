src/app/index.js
// src/app/index.js

import { initState } from "./stateInit.js";
import { loadState } from "./stateLoad.js";
import { mergeState } from "./stateMerge.js";
import { saveState } from "./stateSave.js";
import { startAutosave } from "./autosave.js";

import { renderHeader } from "./header.js";
import { renderNav } from "./nav.js";
import { renderCurrentView } from "./router.js";

import config from "../data/config.json";

/**
 * Boot the UMKC Dynasty v8.0 application.
 * Loads state, merges canon, initializes UI, and starts autosave.
 */
export function boot() {
  // Load saved state (if any)
  const saved = loadState(config.saveKey);

  // Merge saved state with fresh canon defaults
  const state = mergeState(saved);

  // Initial save to ensure structure is correct
  saveState(config.saveKey, state);

  // Render UI shell
  renderHeader(state);
  renderNav(state);

  // Render initial view
  renderCurrentView(state);

  // Start autosave loop
  startAutosave(config.saveKey, state);

  console.log(`[UMKC Dynasty v${state.version}] Boot complete. Phase: ${state.currentPhase}`);
}

// Auto‑boot when DOM is ready
if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", boot);
} else {
  boot();
}

src/app/bootstrap.js
// src/app/bootstrap.js

/**
 * Ensure the root DOM containers exist for the v8.0 SPA.
 * Creates #app-header, #app-nav, and #app-view if missing.
 */
export function bootstrapDOM() {
  // Root app container
  let root = document.getElementById("app-root");
  if (!root) {
    root = document.createElement("div");
    root.id = "app-root";
    document.body.appendChild(root);
  }

  // Header container
  let header = document.getElementById("app-header");
  if (!header) {
    header = document.createElement("div");
    header.id = "app-header";
    root.appendChild(header);
  }

  // Navigation container
  let nav = document.getElementById("app-nav");
  if (!nav) {
    nav = document.createElement("div");
    nav.id = "app-nav";
    root.appendChild(nav);
  }

  // Main view container
  let view = document.getElementById("app-view");
  if (!view) {
    view = document.createElement("div");
    view.id = "app-view";
    root.appendChild(view);
  }
}


