          <tr>
            <th>Position</th>
            <th>Leader</th>
            <th>Challenger</th>
            <th>Gap</th>
          </tr>
        </thead>
        <tbody>
          ${camp.positionBattles.map(b => renderBattleRow(b)).join("")}
        </tbody>
      </table>
    </section>
  `;
}

function renderBattleRow(b) {
  return `
    <tr>
      <td>${b.position}</td>
      <td>${b.leader}</td>
      <td>${b.challenger}</td>
      <td>${b.gap}</td>
    </tr>
  `;
}

function renderDevelopmentNotes(camp) {
  if (!camp.developmentNotes || camp.developmentNotes.length === 0) {
    return `
      <section class="camp-section">
        <h3>Development Notes</h3>
        <div class="camp-card">No notes yet.</div>
      </section>
    `;
  }

  return `
    <section class="camp-section">
      <h3>Development Notes</h3>
      <ul class="camp-list">
        ${camp.developmentNotes.map(n => `<li>${n}</li>`).join("")}
      </ul>
    </section>
  `;
}

function renderScrimmageResults(camp) {
  if (!camp.scrimmageResults || camp.scrimmageResults.length === 0) {
    return `
      <section class="camp-section">
        <h3>Scrimmage Results</h3>
        <div class="camp-card">No scrimmages recorded.</div>
      </section>
    `;
  }

  return `
    <section class="camp-section">
      <h3>Scrimmage Results</h3>
      <table class="camp-table">
        <thead>
          <tr>
            <th>Offense</th>
            <th>Defense</th>
            <th>Summary</th>
          </tr>
        </thead>
        <tbody>
          ${camp.scrimmageResults.map(r => renderScrimmageRow(r)).join("")}
        </tbody>
      </table>
    </section>
  `;
}

function renderScrimmageRow(r) {
  return `
    <tr>
      <td>${r.offenseScore}</td>
      <td>${r.defenseScore}</td>
      <td>${r.summary}</td>
    </tr>
  `;
}


// src/ui/views/gamedayView.js

export function renderGameDay(state) {
  const game = getCurrentGame(state);

  if (!game) {
    return `
      <div class="view-gameday">
        <h2>Game Day</h2>
        <div class="gameday-card">No game scheduled this week.</div>
      </div>
    `;
  }

  return `
    <div class="view-gameday">
      <h2>Game Day — Week ${game.week}</h2>

      ${renderOpponentPanel(game)}
      ${renderPregameNotes(game)}
      ${renderScoringSummary(game)}
      ${renderDriveChart(game)}
      ${renderPlayerStats(game)}
      ${renderPostgameNotes(game)}
      ${renderBroadcastPanel(state)}
    </div>
  `;
}

/* -----------------------------
   SUBCOMPONENTS
------------------------------*/

function getCurrentGame(state) {
  return state.schedule.find(g => g.week === state.currentWeek);
}

function renderOpponentPanel(game) {
  return `
    <section class="gameday-section">
      <h3>Opponent</h3>
      <div class="gameday-card">
        <div><strong>${game.opponent}</strong></div>
        <div>${game.location === "HOME" ? "Home — Durwood Stadium" : "Away"}</div>
        <div>${game.date}</div>
      </div>
    </section>
  `;
}

function renderPregameNotes(game) {
  const notes = game.pregameNotes || [];

  if (notes.length === 0) {
    return `
      <section class="gameday-section">
        <h3>Pregame Notes</h3>
        <div class="gameday-card">No pregame notes.</div>
      </section>
    `;
  }

  return `
    <section class="gameday-section">
      <h3>Pregame Notes</h3>
      <ul class="gameday-list">
        ${notes.map(n => `<li>${n}</li>`).join("")}
      </ul>
    </section>
  `;
}

function renderScoringSummary(game) {
  const scoring = game.scoringSummary || [];

  if (scoring.length === 0) {
    return `
      <section class="gameday-section">
        <h3>Scoring Summary</h3>
        <div class="gameday-card">No scoring plays recorded.</div>
      </section>
    `;
  }

  return `
    <section class="gameday-section">
      <h3>Scoring Summary</h3>
      <table class="gameday-table">
        <thead>
          <tr>
            <th>Quarter</th>
            <th>Team</th>
            <th>Play</th>
          </tr>
        </thead>
        <tbody>
          ${scoring.map(s => renderScoringRow(s)).join("")}
        </tbody>
      </table>
    </section>
  `;
}

function renderScoringRow(s) {
  return `
    <tr>
      <td>${s.quarter}</td>
      <td>${s.team}</td>
      <td>${s.play}</td>
    </tr>
  `;
}

function renderDriveChart(game) {
  const drives = game.driveChart || [];

  if (drives.length === 0) {
    return `
      <section class="gameday-section">
        <h3>Drive Chart</h3>
        <div class="gameday-card">No drives recorded.</div>
      </section>
    `;
  }

  return `
    <section class="gameday-section">
      <h3>Drive Chart</h3>
      <table class="gameday-table">
        <thead>
          <tr>
            <th>Drive</th>
            <th>Result</th>
            <th>Plays</th>
            <th>Yards</th>
          </tr>
        </thead>
        <tbody>
          ${drives.map(d => renderDriveRow(d)).join("")}
        </tbody>
      </table>
    </section>
  `;
}

function renderDriveRow(d) {
  return `
    <tr>
      <td>${d.number}</td>
      <td>${d.result}</td>
      <td>${d.plays}</td>
      <td>${d.yards}</td>
    </tr>
  `;
}

function renderPlayerStats(game) {
  const stats = game.playerStats || [];

  if (stats.length === 0) {
    return `
      <section class="gameday-section">
        <h3>Player Stats</h3>
        <div class="gameday-card">No player stats recorded.</div>
      </section>
    `;
  }

  return `
    <section class="gameday-section">
      <h3>Player Stats</h3>
      <table class="gameday-table">
        <thead>
          <tr>
            <th>Player</th>
            <th>Pos</th>
            <th>Stat Line</th>
          </tr>
        </thead>
        <tbody>
          ${stats.map(s => renderPlayerStatRow(s)).join("")}
        </tbody>
      </table>
    </section>
  `;
}

function renderPlayerStatRow(s) {
  return `
    <tr>
      <td>${s.name}</td>
      <td>${s.pos}</td>
      <td>${s.line}</td>
    </tr>
  `;
}

function renderPostgameNotes(game) {
  const notes = game.postgameNotes || [];

  if (notes.length === 0) {
    return `
      <section class="gameday-section">
        <h3>Postgame Notes</h3>
        <div class="gameday-card">No postgame notes.</div>
      </section>
    `;
  }

  return `
    <section class="gameday-section">
      <h3>Postgame Notes</h3>
      <ul class="gameday-list">
        ${notes.map(n => `<li>${n}</li>`).join("")}
      </ul>
    </section>
  `;
}

function renderBroadcastPanel(state) {
  const entries = state.broadcast.entries || [];

  if (entries.length === 0) {
    return `
      <section class="gameday-section">
        <h3>Broadcast Log</h3>
        <div class="gameday-card">No broadcast entries.</div>
      </section>
    `;
  }

  return `
    <section class="gameday-section">
      <h3>Broadcast Log</h3>
      <ul class="gameday-list">
        ${entries.map(e => `<li>${e.message}</li>`).join("")}
      </ul>
    </section>
  `;
}


// src/ui/views/recruitingView.js

export function renderRecruiting(state) {
  const board = state.recruiting.currentBoard || [];

  return `
    <div class="view-recruiting">
      <h2>Recruiting Board</h2>

      ${
        board.length === 0
          ? renderEmptyBoard()
          : renderBoardTable(board)
      }
    </div>
  `;
}

/* -----------------------------
   SUBCOMPONENTS
------------------------------*/

function renderEmptyBoard() {
  return `
    <div class="recruiting-card">
      No prospects on the board.
    </div>
  `;
}

function renderBoardTable(board) {
  return `
    <table class="recruiting-table">
      <thead>
        <tr>
          <th>Prospect</th>
          <th>Pos</th>
          <th>Stars</th>
          <th>Home</th>
          <th>Interest</th>
          <th>Pipeline</th>
          <th>Pitches</th>
        </tr>
      </thead>
      <tbody>
        ${board.map(p => renderProspectRow(p)).join("")}
      </tbody>
    </table>
  `;
}

function renderProspectRow(p) {
  return `
    <tr>
      <td>${p.name}</td>
      <td>${p.pos}</td>
      <td>${p.stars}★</td>
      <td>${p.homeState}</td>
      <td>${renderInterestBar(p.interest)}</td>
      <td>${p.pipelineState || "—"}</td>
      <td>${renderPitchSummary(p.pitches)}</td>
    </tr>
  `;
}

function renderInterestBar(value = 0) {
  const pct = Math.round(value * 100);
  return `
    <div class="interest-bar">
      <div class="interest-bar__fill" style="width:${pct}%"></div>
      <span class="interest-bar__label">${pct}%</span>
    </div>
  `;
}

function renderPitchSummary(pitches = []) {
  if (!pitches.length) return "—";
  return pitches.map(p => p.tag).join(", ");
}


