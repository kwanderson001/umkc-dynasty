/**
 * Dynasty Home Page v1.0
 * -----------------------
 * The landing page for the UMKC Football Dynasty web app.
 * Introduces the program, shows branding, and links to dashboard + history.
 *
 * This file does NOT simulate football. It renders identity + navigation.
 */

import React, { useEffect, useState } from "react";
import { DynastyClientSDK } from "../DynastyClientSDK.js";
import "./DynastyUIStyles.css";

export default function DynastyHomePage() {
  const sdk = new DynastyClientSDK("http://localhost:3000");

  const [metadata, setMetadata] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  // Fetch program metadata on mount
  useEffect(() => {
    async function load() {
      try {
        const meta = await sdk.getMetadata();
        setMetadata(meta);
        setLoading(false);
      } catch (err) {
        setError(err.message);
        setLoading(false);
      }
    }

    load();
  }, []);

  if (loading) {
    return (
      <div style={{ padding: "2rem", textAlign: "center" }}>
        <h2>Loading UMKC Football…</h2>
      </div>
    );
  }

  if (error) {
    return (
      <div style={{ padding: "2rem", textAlign: "center", color: "red" }}>
        <h2>Error loading home page</h2>
        <p>{error}</p>
      </div>
    );
  }

  return (
    <div style={{ padding: "2rem", maxWidth: "900px", margin: "0 auto" }}>
      {/* Header */}
      <header style={{ textAlign: "center", marginBottom: "2rem" }}>
        <img
          src="/assets/umkc_roos_logo.png"
          alt="UMKC Roos Football"
          style={{ width: "160px", marginBottom: "1rem" }}
        />
        <h1>{metadata.programName}</h1>
        <p style={{ fontSize: "1.2rem", marginTop: "0.5rem" }}>
          <strong>{metadata.headCoach}</strong>, Head Coach
        </p>
        <p style={{ marginTop: "0.5rem" }}>
          Inaugural Season: <strong>{metadata.inauguralYear}</strong>
        </p>
      </header>

      {/* Program Identity */}
      <section className="season-card">
        <h2>Program Identity</h2>
        <p><strong>Slogan:</strong> Kansas City’s Team</p>
        <p><strong>Philosophy:</strong> Development First. Championship Always.</p>
        <p><strong>Total Seasons Completed:</strong> {metadata.totalSeasons}</p>
      </section>

      {/* Navigation */}
      <section className="season-card">
        <h2>Explore the Dynasty</h2>
        <ul>
          <li>
            <a href="/dashboard" style={{ color: "#0057b8", fontWeight: "600" }}>
              Dynasty Dashboard
            </a>
          </li>
          <li>
            <a href="/seasons" style={{ color: "#0057b8", fontWeight: "600" }}>
              Season Archives
            </a>
          </li>
          <li>
            <a href="/history" style={{ color: "#0057b8", fontWeight: "600" }}>
              Program History
            </a>
          </li>
          <li>
            <a href="/export" style={{ color: "#0057b8", fontWeight: "600" }}>
              Export Dynasty Data
            </a>
          </li>
        </ul>
      </section>

      {/* Footer */}
      <footer style={{ textAlign: "center", marginTop: "3rem", opacity: 0.7 }}>
        <p>UMKC Football Dynasty System v1.0</p>
        <p>Built for simulation, storytelling, and legacy.</p>
      </footer>
    </div>
  );
}

