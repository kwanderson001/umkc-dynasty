/**
 * Dynasty Seasons Page v1.0
 * -------------------------
 * Displays all seasons in the dynasty using SeasonCard.
 *
 * This file does NOT simulate football. It renders season archives.
 */

import React, { useEffect, useState } from "react";
import { DynastyClientSDK } from "../DynastyClientSDK.js";

import { SeasonCard } from "./DynastyUIComponents.js";
import "./DynastyUIStyles.css";

export default function DynastySeasonsPage() {
  const sdk = new DynastyClientSDK("http://localhost:3000");

  const [seasons, setSeasons] = useState([]);
  const [metadata, setMetadata] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  // Fetch seasons + metadata on mount
  useEffect(() => {
    async function load() {
      try {
        const meta = await sdk.getMetadata();
        const seasonList = await sdk.getSeasons();

        setMetadata(meta);
        setSeasons(seasonList);
        setLoading(false);
      } catch (err) {
        setError(err.message);
        setLoading(false);
      }
    }

    load();
  }, []);

  if (loading) {
    return (
      <div style={{ padding: "2rem", textAlign: "center" }}>
        <h2>Loading Season Archives…</h2>
      </div>
    );
  }

  if (error) {
    return (
      <div style={{ padding: "2rem", textAlign: "center", color: "red" }}>
        <h2>Error loading seasons</h2>
        <p>{error}</p>
      </div>
    );
  }

  return (
    <div style={{ padding: "2rem", maxWidth: "900px", margin: "0 auto" }}>
      {/* Header */}
      <header style={{ marginBottom: "2rem", textAlign: "center" }}>
        <h1>{metadata.programName} Season Archives</h1>
        <p>
          Total Seasons Completed: <strong>{metadata.totalSeasons}</strong>
        </p>
      </header>

      {/* Season Cards */}
      <section>
        {seasons.map((season, idx) => (
          <SeasonCard key={idx} card={season.seasonCards ? season.seasonCards[0] : {
            year: season.year,
            record: season.record,
            headline: season.seasonNarrative.summary.headline,
            prestigeChange: season.prestigeChange,
            attendanceAvg: season.attendanceAvg,
            keyMoments: season.seasonTimeline.slice(0, 3)
          }} />
        ))}
      </section>

      {/* Footer */}
      <footer style={{ textAlign: "center", marginTop: "3rem", opacity: 0.7 }}>
        <p>UMKC Football Dynasty System v1.0</p>
        <p>Season Archive Browser</p>
      </footer>
    </div>
  );
}

src/client/ui/DynastyHistoryPage.jsx
// src/client/ui/DynastyHistoryPage.jsx

/**
 * Dynasty History Page v1.0
 * -------------------------
 * Displays full program history:
 *   - prestige timeline
 *   - rivalry history
 *   - recruiting pipeline
 *   - milestones
 *   - coach career arc
 *
 * This file does NOT simulate football. It renders historical dynasty data.
 */

import React, { useEffect, useState } from "react";
import { DynastyClientSDK } from "../DynastyClientSDK.js";

import {
  PrestigeGraph,
  RivalryCard,
  RecruitingPipelineChart,
  CoachCareerSummary,
  DynastyTimeline
} from "./DynastyUIComponents.js";

import "./DynastyUIStyles.css";

export default function DynastyHistoryPage() {
  const sdk = new DynastyClientSDK("http://localhost:3000");

  const [history, setHistory] = useState(null);
  const [metadata, setMetadata] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  // Fetch program history + metadata on mount
  useEffect(() => {
    async function load() {
      try {
        const meta = await sdk.getMetadata();
        const hist = await sdk.getProgramHistory();

        setMetadata(meta);
        setHistory(hist);
        setLoading(false);
      } catch (err) {
        setError(err.message);
        setLoading(false);
      }
    }

    load();
  }, []);

  if (loading) {
    return (
      <div style={{ padding: "2rem", textAlign: "center" }}>
        <h2>Loading Program History…</h2>
      </div>
    );
  }

  if (error) {
    return (
      <div style={{ padding: "2rem", textAlign: "center", color: "red" }}>
        <h2>Error loading history</h2>
        <p>{error}</p>
      </div>
    );
  }

  const { prestigeTimeline, rivalryHistory, recruitingPipeline, milestones, coachCareer } = history;

  // Group rivalry history into cards
  const rivalryGroups = {};
  rivalryHistory.forEach(r => {
    if (!rivalryGroups[r.opponent]) rivalryGroups[r.opponent] = [];
    rivalryGroups[r.opponent].push(r);
  });

  const rivalryCards = Object.entries(rivalryGroups).map(([opponent, games]) => ({
    opponent,
    totalMeetings: games.length,
    wins: games.filter(g => g.result === "WIN").length,
    losses: games.filter(g => g.result === "LOSS").length,
    recentHeadline: games[games.length - 1]?.headline || "No recent game",
    history: games
  }));

  return (
    <div style={{ padding: "2rem", maxWidth: "900px", margin: "0 auto" }}>
      {/* Header */}
      <header style={{ textAlign: "center", marginBottom: "2rem" }}>
        <h1>{metadata.programName} Program History</h1>
        <p>
          Head Coach: <strong>{metadata.headCoach}</strong>
        </p>
        <p>
          Seasons Completed: <strong>{metadata.totalSeasons}</strong>
        </p>
      </header>

      {/* Prestige Timeline */}
      <section>
        <PrestigeGraph data={prestigeTimeline} />
      </section>

      {/* Rivalries */}
      <section>
        <h2>Rivalry History</h2>
        {rivalryCards.map((card, idx) => (
          <RivalryCard key={idx} card={card} />
        ))}
      </section>

      {/* Recruiting Pipeline */}
      <section>
        <RecruitingPipelineChart data={recruitingPipeline.map(entry => {
          const region = entry.split(" ").slice(-1)[0];
          const count = parseInt(entry.match(/\d+/)?.[0] || 0);
          return { region, count };
        })} />
      </section>

      {/* Milestones */}
      <section className="season-card">
        <h2>Program Milestones</h2>
        <ul>
          {milestones.map((m, idx) => (
            <li key={idx}>
              <strong>{m.year}</strong>: {m.detail}
            </li>
          ))}
        </ul>
      </section>

      {/* Coach Career */}
      <section>
        <CoachCareerSummary summary={{
          headCoach: metadata.headCoach,
          seasons: metadata.totalSeasons,
          careerRecord: coachCareer[0] || "",
          careerNarrative: coachCareer
        }} />
      </section>

      {/* Dynasty Timeline */}
      <section>
        <DynastyTimeline timeline={history.seasons.map(s => ({
          year: s.year,
          record: s.record,
          headline: s.seasonNarrative.summary.headline,
          prestigeChange: s.prestigeChange
        }))} />
      </section>

      {/* Footer */}
      <footer style={{ textAlign: "center", marginTop: "3rem", opacity: 0.7 }}>
        <p>UMKC Football Dynasty System v1.0</p>
        <p>Program History Archive</p>
      </footer>
    </div>
  );
}

src/client/ui/SeasonDetailPage.jsx
// src/client/ui/SeasonDetailPage.jsx

/**
 * Season Detail Page v1.0
 * -----------------------
 * Displays full details for a single season:
 *   - weekly narratives
 *   - season narrative
 *   - offseason narrative
 *   - stats + awards
 *   - recruiting class
 *   - portal moves
 *   - staff changes
 *   - culture tags
 *
 * This file does NOT simulate football. It renders season details.
 */

import React, { useEffect, useState } from "react";
import { DynastyClientSDK } from "../DynastyClientSDK.js";

import {
  SeasonCard,
  PrestigeGraph,
  AttendanceGraph,
  RecruitingPipelineChart
} from "./DynastyUIComponents.js";

import "./DynastyUIStyles.css";

export default function SeasonDetailPage({ year }) {
  const sdk = new DynastyClientSDK("http://localhost:3000");

  const [season, setSeason] = useState(null);
  const [metadata, setMetadata] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  // Fetch season + metadata on mount
  useEffect(() => {
    async function load() {
      try {
        const meta = await sdk.getMetadata();
        const seasons = await sdk.getSeasons();

        const found = seasons.find(s => s.year === year);

        if (!found) {
          throw new Error(`Season ${year} not found.`);
        }

        setMetadata(meta);
        setSeason(found);
        setLoading(false);
      } catch (err) {
        setError(err.message);
        setLoading(false);
      }
    }

    load();
  }, [year]);

  if (loading) {
    return (
      <div style={{ padding: "2rem", textAlign: "center" }}>
        <h2>Loading Season {year}…</h2>
      </div>
    );
  }

  if (error) {
    return (
      <div style={{ padding: "2rem", textAlign: "center", color: "red" }}>
        <h2>Error loading season</h2>
        <p>{error}</p>
      </div>
    );
  }

  const {
    record,
    weeklyNarratives,
    seasonNarrative,
    offseasonNarrative,
    statisticalLeaders,
    awards,
    recruitingClass,
    portalMoves,
    staffChanges,
    cultureTags,
    attendanceAvg,
    prestigeChange,
    seasonTimeline
  } = season;

  return (
    <div style={{ padding: "2rem", maxWidth: "900px", margin: "0 auto" }}>
      {/* Header */}
      <header style={{ textAlign: "center", marginBottom: "2rem" }}>
        <h1>{metadata.programName} — {year} Season</h1>
        <p><strong>Record:</strong> {record}</p>
        <p><strong>Prestige Change:</strong> {prestigeChange}</p>
        <p><strong>Attendance Avg:</strong> {attendanceAvg}</p>
      </header>

      {/* Season Summary Card */}
      <section>
        <SeasonCard
          card={{
            year,
            record,
            headline: seasonNarrative.summary.headline,
            prestigeChange,
            attendanceAvg,
            keyMoments: seasonTimeline.slice(0, 3)
          }}
        />
      </section>

      {/* Weekly Narratives */}
      <section className="season-card">
        <h2>Weekly Narratives</h2>
        <ul>
          {weeklyNarratives.map((w, idx) => (
            <li key={idx}>
              <strong>Week {w.week} vs {w.opponent}</strong> — {w.result} ({w.score})  
              <br />
              {w.summary.headline}
            </li>
          ))}
        </ul>
      </section>

      {/* Season Narrative */}
      <section className="season-card">
        <h2>Season Narrative</h2>
        <p>{seasonNarrative.fullText}</p>
      </section>

      {/* Offseason Narrative */}
      <section className="season-card">
        <h2>Offseason Narrative</h2>
        <p>{offseasonNarrative.fullText}</p>
      </section>

      {/* Statistical Leaders */}
      <section className="season-card">
        <h2>Statistical Leaders</h2>
        <ul>
          {Object.entries(statisticalLeaders).map(([key, value], idx) => (
            <li key={idx}>
              <strong>{key.replace("Leader", "")}:</strong> {value?.name || "N/A"}  
              {value && ` — ${value.stat}`}
            </li>
          ))}
        </ul>
      </section>

      {/* Awards */}
      <section className="season-card">
        <h2>Awards</h2>
        <h4>Team Awards</h4>
        <ul>
          {awards.teamAwards.map((a, idx) => (
            <li key={idx}>{a}</li>
          ))}
        </ul>

        <h4>Player Awards</h4>
        <ul>
          {awards.playerAwards.map((a, idx) => (
            <li key={idx}>{a}</li>
          ))}
        </ul>
      </section>

      {/* Recruiting Class */}
      <section className="season-card">
        <h2>Recruiting Class</h2>
        <ul>
          {recruitingClass.map((r, idx) => (
            <li key={idx}>
              {r.name} — {r.position}, {r.stars}★ ({r.hometown})
            </li>
          ))}
        </ul>
      </section>

      {/* Portal Moves */}
      <section className="season-card">
        <h2>Portal Moves</h2>
        <ul>
          {portalMoves.map((p, idx) => (
            <li key={idx}>
              {p.type === "IN" ? "Added" : "Lost"} {p.name} ({p.position})  
              {p.from && ` from ${p.from}`}  
              {p.to && ` to ${p.to}`}
            </li>
          ))}
        </ul>
      </section>

      {/* Staff Changes */}
      <section className="season-card">
        <h2>Staff Changes</h2>
        <ul>
          {staffChanges.map((s, idx) => (
            <li key={idx}>{s}</li>
          ))}
        </ul>
      </section>

      {/* Culture Tags */}
      <section className="season-card">
        <h2>Culture Tags</h2>
        <ul>
          {cultureTags.map((tag, idx) => (
            <li key={idx}>{tag}</li>
          ))}
        </ul>
      </section>

      {/* Footer */}
      <footer style={{ textAlign: "center", marginTop: "3rem", opacity: 0.7 }}>
        <p>UMKC Football Dynasty System v1.0</p>
        <p>Season Detail Archive</p>
      </footer>
    </div>
  );
}

src/client/ui/DynastyAppRouter.jsx
// src/client/ui/DynastyAppRouter.jsx

/**
 * Dynasty App Router v1.0
 * -----------------------
 * Connects all dynasty pages into a single React application:
 *   - Home Page
 *   - Dashboard Page
 *   - Seasons Page
 *   - History Page
 *   - Season Detail Page (dynamic)
 *
 * This file does NOT simulate football. It provides navigation.
 */

import React from "react";
import {
  BrowserRouter as Router,
  Routes,
  Route
} from "react-router-dom";

import DynastyHomePage from "./DynastyHomePage.jsx";
import DynastyDashboardPage from "./DynastyDashboardPage.jsx";
import DynastySeasonsPage from "./DynastySeasonsPage.jsx";
import DynastyHistoryPage from "./DynastyHistoryPage.jsx";
import SeasonDetailPage from "./SeasonDetailPage.jsx";

export default function DynastyAppRouter() {
  return (
    <Router>
      <Routes>
        {/* Home */}
        <Route path="/" element={<DynastyHomePage />} />

        {/* Dashboard */}
        <Route path="/dashboard" element={<DynastyDashboardPage />} />

        {/* Seasons */}
        <Route path="/seasons" element={<DynastySeasonsPage />} />

        {/* Program History */}
        <Route path="/history" element={<DynastyHistoryPage />} />

        {/* Season Detail (dynamic) */}
        <Route
          path="/season/:year"
          element={
            <SeasonDetailWrapper />
          }
        />
      </Routes>
    </Router>
  );
}

/**
 * Wrapper to extract :year param and pass it to SeasonDetailPage
 */
function SeasonDetailWrapper() {
  const { year } = useParams();
  return <SeasonDetailPage year={parseInt(year)} />;
}

