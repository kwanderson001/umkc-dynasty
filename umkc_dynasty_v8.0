DynastyDevInstructions.md


src/app/autosave.js
// src/app/autosave.js

import { saveState } from "./stateSave.js";

/**
 * Start an autosave loop that saves the state every intervalMs.
 * Default interval: 120000 ms (2 minutes)
 */
export function startAutosave(saveKey, state, intervalMs = 120000) {
  try {
    setInterval(() => {
      saveState(saveKey, state);
    }, intervalMs);
  } catch (err) {
    console.warn("[v8] Autosave failed to start:", err);
  }
}

src/app/router.js
// src/app/router.js

import { V8_TABS } from "./tabsConfig.js";

// --- View Imports ---
import { renderDashboard } from "../ui/views/dashboardView.js";
import { renderSchedule } from "../ui/views/scheduleView.js";
import { renderRoster } from "../ui/views/rosterView.js";
import { renderStadium } from "../ui/views/stadiumView.js";

// Placeholder imports for future views
// (You will add these as you build each view)
import { renderTrainingCamp } from "../ui/views/campView.js";
import { renderGameDay } from "../ui/views/gamedayView.js";
import { renderRecruiting } from "../ui/views/recruitingView.js";
import { renderNil } from "../ui/views/nilView.js";
import { renderRivalries } from "../ui/views/rivalriesView.js";
import { renderStaff } from "../ui/views/staffView.js";
import { renderBroadcast } from "../ui/views/broadcastView.js";

/**
 * Map tab IDs to view renderers.
 * This is the heart of the v8.0 routing system.
 */
const VIEW_MAP = {
  dashboard: renderDashboard,
  camp: renderTrainingCamp,
  roster: renderRoster,
  schedule: renderSchedule,
  gameday: renderGameDay,
  recruiting: renderRecruiting,
  nil: renderNil,
  rivalries: renderRivalries,
  staff: renderStaff,
  broadcast: renderBroadcast,
  stadium: renderStadium
};

/**
 * Set the active tab and re-render the current view.
 */
export function setTab(tabId, state) {
  // Validate tab
  const exists = V8_TABS.some(t => t.id === tabId);
  if (!exists) {
    console.warn(`[v8] Unknown tab: ${tabId}`);
    return;
  }

  // Phase guard: cannot enter Game Day during Training Camp
  if (state.currentPhase === "TRAINING_CAMP" && tabId === "gameday") {
    tabId = "camp"; // Force redirect
  }

  state.currentTab = tabId;
  renderCurrentView(state);

  // Update active tab styling
  document.querySelectorAll(".roo-nav__tab").forEach(el => {
    el.classList.toggle("active", el.dataset.tab === tabId);
  });
}

/**
 * Render the view for the current tab.
 */
export function renderCurrentView(state) {
  const el = document.getElementById("app-view");
  if (!el) return;

  const renderer = VIEW_MAP[state.currentTab];

  if (!renderer) {
    el.innerHTML = `<div>View not implemented: ${state.currentTab}</div>`;
    return;
  }

  el.innerHTML = renderer(state);
}

