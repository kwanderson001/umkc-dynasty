// src/app/tabsConfig.js

/**
 * v8.0 Tab Configuration
 * Each tab has:
 * - id: unique identifier
 * - label: text shown in the nav bar
 * - icon: emoji icon for quick visual recognition
 */

export const V8_TABS = [
  { id: "dashboard",   label: "Dashboard",     icon: "🏠" },
  { id: "camp",        label: "Training Camp", icon: "⛺" },
  { id: "roster",      label: "Roster",        icon: "👥" },
  { id: "schedule",    label: "Schedule",      icon: "📅" },
  { id: "gameday",     label: "Game Day",      icon: "🏈" },
  { id: "recruiting",  label: "Recruiting",    icon: "📋" },
  { id: "nil",         label: "NIL / Roo 816", icon: "💰" },
  { id: "rivalries",   label: "Rivalries",     icon: "🔥" },
  { id: "staff",       label: "Staff",         icon: "🎓" },
  { id: "broadcast",   label: "Broadcast",     icon: "📻" },
  { id: "stadium",     label: "Stadium",       icon: "🏟️" }
];

src/app/header.js
// src/app/header.js

/**
 * Render the UMKC Dynasty v8.0 header.
 * Displays program identity, current year, and current phase.
 */
export function renderHeader(state) {
  const el = document.getElementById("app-header");
  if (!el) return;

  el.innerHTML = `
    <div class="roo-header">
      <div class="roo-header__logo">
        🦘 <span>UMKC</span> DYNASTY
      </div>

      <div class="roo-header__meta">
        <div class="roo-header__season">
          ${state.currentYear} Season
        </div>

        <div class="roo-header__phase">
          ${state.currentPhase === "TRAINING_CAMP"
            ? "⛺ Training Camp"
            : "Week " + state.currentWeek}
        </div>
      </div>
    </div>
  `;
}

src/app/nav.js
// src/app/nav.js

import { V8_TABS } from "./tabsConfig.js";
import { setTab } from "./router.js";

/**
 * Render the navigation bar into #app-nav.
 * Each tab triggers setTab() and re-renders the current view.
 */
export function renderNav(state) {
  const el = document.getElementById("app-nav");
  if (!el) return;

  el.innerHTML = `
    <nav class="roo-nav">
      ${V8_TABS.map(tab => `
        <div 
          class="roo-nav__tab ${tab.id === state.currentTab ? "active" : ""}"
          data-tab="${tab.id}"
        >
          ${tab.icon} ${tab.label}
        </div>
      `).join("")}
    </nav>
  `;

  // Attach click handlers
  document.querySelectorAll(".roo-nav__tab").forEach(tabEl => {
    tabEl.addEventListener("click", () => {
      const tabId = tabEl.dataset.tab;
      setTab(tabId, state);
    });
  });
}


// src/ui/views/dashboardView.js

export function renderDashboard(state) {
  return `
    <div class="view-dashboard">

      <!-- SECTION: Season Summary -->
      <section class="dash-section">
        <h2>Season Overview</h2>
        <div class="dash-card">
          <div><strong>Year:</strong> ${state.currentYear}</div>
          <div><strong>Phase:</strong> ${state.currentPhase}</div>
          <div><strong>Week:</strong> ${state.currentWeek}</div>
        </div>
      </section>

      <!-- SECTION: Next Game -->
      <section class="dash-section">
        <h2>Next Game</h2>
        ${renderNextGame(state)}
      </section>

      <!-- SECTION: Recruiting Snapshot -->
      <section class="dash-section">
        <h2>Recruiting Snapshot</h2>
        ${renderRecruitingSnapshot(state)}
      </section>

      <!-- SECTION: NIL Snapshot -->
      <section class="dash-section">
        <h2>NIL / Roo 816 Snapshot</h2>
        ${renderNilSnapshot(state)}
      </section>

      <!-- SECTION: Stadium Snapshot -->
      <section class="dash-section">
        <h2>Stadium & Facilities</h2>
        ${renderStadiumSnapshot(state)}
      </section>

      <!-- SECTION: Culture Metrics -->
      <section class="dash-section">
        <h2>Team Culture</h2>
        ${renderCultureSnapshot(state)}
      </section>

    </div>
  `;
}

/* -----------------------------
   SUBCOMPONENTS
------------------------------*/

function renderNextGame(state) {
  const next = state.schedule.find(g => !g.result);

  if (!next) {
    return `<div class="dash-card">No remaining games.</div>`;
  }

  return `
    <div class="dash-card">
      <div><strong>Opponent:</strong> ${next.opponent}</div>
      <div><strong>Location:</strong> ${next.location}</div>
      <div><strong>Date:</strong> ${next.date}</div>
    </div>
  `;
}

function renderRecruitingSnapshot(state) {
  const board = state.recruiting.currentBoard.slice(0, 5);

  if (board.length === 0) {
    return `<div class="dash-card">No prospects on the board.</div>`;
  }

  return `
    <div class="dash-card">
      <ul>
        ${board
          .map(
            p => `
          <li>
            ${p.name} — ${p.pos}, ${p.stars}★ (${p.homeState})
          </li>
        `
          )
          .join("")}
      </ul>
    </div>
  `;
}

function renderNilSnapshot(state) {
  const deals = state.nil.deals.length;
  const donors = state.nil.donors.length;

  return `
    <div class="dash-card">
      <div><strong>NIL Deals:</strong> ${deals}</div>
      <div><strong>Donors:</strong> ${donors}</div>
    </div>
  `;
}

function renderStadiumSnapshot(state) {
  return `
    <div class="dash-card">
      <div><strong>Name:</strong> ${state.stadium.name}</div>
      <div><strong>Capacity:</strong> ${state.stadium.capacity}</div>
      <div><strong>Surface:</strong> ${state.stadium.surface}</div>
    </div>
  `;
}

function renderCultureSnapshot(state) {
  return `
    <div class="dash-card">
      <div><strong>Cohesion:</strong> ${state.culture.cohesion}</div>
      <div><strong>Morale:</strong> ${state.culture.morale}</div>
      <div><strong>Prestige:</strong> ${state.culture.prestige}</div>
    </div>
  `;
}

// src/ui/views/scheduleView.js

export function renderSchedule(state) {
  const games = state.schedule;

  return `
    <div class="view-schedule">
      <h2>2024 Schedule</h2>

      <table class="schedule-table">
        <thead>
          <tr>
            <th>Week</th>
            <th>Opponent</th>
            <th>Location</th>
            <th>Date</th>
            <th>Broadcast</th>
            <th>Result</th>
          </tr>
        </thead>

        <tbody>
          ${games.map(g => renderGameRow(g)).join("")}
        </tbody>
      </table>
    </div>
  `;
}

/* -----------------------------
   SUBCOMPONENTS
------------------------------*/

function renderGameRow(g) {
  const isBye = g.result === "BYE";
  const played = g.result && g.result !== "BYE";

  const opponent = g.isRivalry
    ? `🔥 ${g.opponent} <span class="rivalry-tag">(${g.isRivalryName})</span>`
    : g.opponent;

  const location = g.location === "HOME"
    ? `Home — Durwood Stadium`
    : `Away — ${g.city}, ${g.state}`;

  const broadcast = g.televised
    ? `📺 ${g.broadcast || ""}`
    : "";

  const result = isBye
    ? `<span class="result-badge bye">BYE</span>`
    : played
    ? `<span class="result-badge ${g.result === "W" ? "win" : "loss"}">
         ${g.result} ${g.score.umkc}-${g.score.opp}
       </span>`
    : `<span class="result-badge pending">—</span>`;

  return `
    <tr class="${g.isRivalry ? "rivalry-row" : ""}">
      <td>${g.week}</td>
      <td>${opponent}</td>
      <td>${location}</td>
      <td>${g.date}</td>
      <td>${broadcast}</td>
      <td>${result}</td>
    </tr>
  `;
}

// src/ui/views/rosterView.js

export function renderRoster(state) {
  const players = state.players;

  // Group players by position
  const groups = groupByPosition(players);

  return `
    <div class="view-roster">
      <h2>Roster</h2>

      ${Object.keys(groups)
        .map(pos => renderPositionGroup(pos, groups[pos]))
        .join("")}
    </div>
  `;
}

/* -----------------------------
   SUBCOMPONENTS
------------------------------*/

function groupByPosition(players) {
  const map = {};
  players.forEach(p => {
    if (!map[p.pos]) map[p.pos] = [];
    map[p.pos].push(p);
  });
  return map;
}

function renderPositionGroup(pos, players) {
  return `
    <section class="roster-group">
      <h3>${pos}</h3>

      <table class="roster-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Year</th>
            <th>HT/WT</th>
            <th>Hometown</th>
            <th>Starter</th>
            <th>Captain</th>
            <th>OVR</th>
            <th>Notes</th>
          </tr>
        </thead>

        <tbody>
          ${players.map(p => renderPlayerRow(p)).join("")}
        </tbody>
      </table>
    </section>
  `;
}

function renderPlayerRow(p) {
  const starter = p.starter
    ? `<span class="badge starter">Starter</span>`
    : "";

  const captain = p.captain
    ? `<span class="badge captain">Captain</span>`
    : "";

  const notes = p.developmentNotes || "";

  return `
    <tr>
      <td>${p.fullName}</td>
      <td>${formatYear(p.year)}</td>
      <td>${p.height} / ${p.weight} lb</td>
      <td>${p.hometown}, ${p.state}</td>
      <td>${starter}</td>
      <td>${captain}</td>
      <td>${p.overall}</td>
      <td>${notes}</td>
    </tr>
  `;
}

function formatYear(year) {
  switch (year) {
    case 1: return "FR";
    case 2: return "SO";
    case 3: return "JR";
    case 4: return "SR";
    case 5: return "GR";
    default: return year;
  }
}

// src/ui/views/stadiumView.js

export function renderStadium(state) {
  const st = state.stadium;

  return `
    <div class="view-stadium">
      <h2>${st.name}</h2>

      ${renderStadiumMeta(st)}
      ${renderAmenities(st)}
      ${renderSections(st)}
      ${renderHomeFieldAdvantage(state)}
    </div>
  `;
}

/* -----------------------------
   SUBCOMPONENTS
------------------------------*/

function renderStadiumMeta(st) {
  return `
    <section class="stadium-section">
      <h3>Stadium Overview</h3>
      <div class="stadium-card">
        <div><strong>Capacity:</strong> ${st.capacity}</div>
        <div><strong>Surface:</strong> ${st.surface}</div>
        <div><strong>Location:</strong> ${st.city}, ${st.state}</div>
        <div><strong>Opened:</strong> ${st.opened}</div>
      </div>
    </section>
  `;
}

function renderAmenities(st) {
  if (!st.amenities || st.amenities.length === 0) {
    return `
      <section class="stadium-section">
        <h3>Amenities</h3>
        <div class="stadium-card">No amenities listed.</div>
      </section>
    `;
  }

  return `
    <section class="stadium-section">
      <h3>Amenities</h3>
      <table class="stadium-table">
        <thead>
          <tr>
            <th>Amenity</th>
            <th>Rating</th>
            <th>Upgraded</th>
          </tr>
        </thead>
        <tbody>
          ${st.amenities.map(a => renderAmenityRow(a)).join("")}
        </tbody>
      </table>
    </section>
  `;
}

function renderAmenityRow(a) {
  return `
    <tr>
      <td>${a.name}</td>
      <td>${a.rating} / ${a.maxRating}</td>
      <td>${a.upgraded ? "✔" : "—"}</td>
    </tr>
  `;
}

function renderSections(st) {
  if (!st.sections || st.sections.length === 0) {
    return `
      <section class="stadium-section">
        <h3>Seating Sections</h3>
        <div class="stadium-card">No sections listed.</div>
      </section>
    `;
  }

  return `
    <section class="stadium-section">
      <h3>Seating Sections</h3>
      <table class="stadium-table">
        <thead>
          <tr>
            <th>Section</th>
            <th>Capacity</th>
            <th>Fill Rate</th>
            <th>Projected Fans</th>
            <th>Loudness</th>
          </tr>
        </thead>
        <tbody>
          ${st.sections.map(s => renderSectionRow(s)).join("")}
        </tbody>
      </table>
    </section>
  `;
}

function renderSectionRow(s) {
  const projected = Math.round(s.capacity * s.fillRate);
  const loudness = Math.round(s.loudness * 100);

  return `
    <tr>
      <td>${s.name}</td>
      <td>${s.capacity}</td>
      <td>${Math.round(s.fillRate * 100)}%</td>
      <td>${projected}</td>
      <td>${loudness}%</td>
    </tr>
  `;
}

function renderHomeFieldAdvantage(state) {
  const hfa = state.stadium.hfa || 0;

  return `
    <section class="stadium-section">
      <h3>Home Field Advantage</h3>
      <div class="stadium-card">
        <div><strong>HFA:</strong> ${hfa.toFixed(1)} pts</div>
      </div>
    </section>
  `;
}


// src/ui/views/campView.js

export function renderTrainingCamp(state) {
  const camp = state.trainingCamp;

  return `
    <div class="view-camp">
      <h2>Training Camp</h2>

      ${renderCampMeta(camp)}
      ${renderPositionBattles(camp)}
      ${renderDevelopmentNotes(camp)}
      ${renderScrimmageResults(camp)}
